<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension-point id="org.jkiss.dbeaver.mockGenerator" name="%mockdata.extension.name" schema="schema/org.jkiss.dbeaver.mockGenerator.exsd"/>

    <extension point="org.jkiss.dbeaver.mockGenerator">

        <generator
                id="numericConstantGenerator"
                label="%generator.numeric.constant.label"
                description="%generator.numeric.constant.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.ConstantGenerator">
            <type kind="NUMERIC"/>

            <propertyGroup label="General">
                <property id="value" label="%generator.numeric.constant.prop.value.label" type="numeric" defaultValue="0"/>
            </propertyGroup>
        </generator>

        <generator
                id="numericSequenceGenerator"
                label="%generator.numeric.sequence.label"
                description="%generator.numeric.sequence.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.NumericSequenceGenerator"
                tags="id,number,order">
            <type kind="NUMERIC"/>

            <propertyGroup label="General">
                <property id="start" label="%generator.numeric.sequence.property.start.label" type="long" defaultValue="1" description="%generator.numeric.sequence.property.start.description"/>
                <property id="step" label="%generator.numeric.sequence.property.step.label" type="long" defaultValue="1" description="%generator.numeric.sequence.property.step.description"/>
                <property id="reverse" label="%generator.numeric.sequence.property.reverse.label" type="boolean" defaultValue="FALSE" description="%generator.numeric.sequence.property.reverse.description"/>
            </propertyGroup>
        </generator>

        <generator
                id="booleanConstantGenerator"
                label="%generator.boolean.constant.label"
                description="%generator.boolean.constant.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.ConstantGenerator">
            <type kind="BOOLEAN"/>

            <propertyGroup label="General">
                <property id="value" label="%generator.boolean.constant.property.value.label" type="boolean" defaultValue="TRUE"/>
            </propertyGroup>
        </generator>

        <generator
                id="booleanRandomGenerator"
                label="Boolean Random"
                description="Random boolean values"
                class="org.jkiss.dbeaver.mockdata.engine.generator.BooleanRandomGenerator">
            <type kind="BOOLEAN"/>
        </generator>

        <generator
                id="booleanSequenceGenerator"
                label="%generator.boolean.sequence.label"
                description="%generator.boolean.sequence.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.BooleanSequenceGenerator">
            <type kind="BOOLEAN"/>

            <propertyGroup label="General">
                <property id="initial" label="%generator.boolean.sequence.property.initial.label" type="boolean" defaultValue="TRUE"/>
                <property id="order" label="%generator.boolean.sequence.property.order.label" type="string" defaultValue="%generator.boolean.sequence.property.order.value.initial" validValues="%generator.boolean.sequence.property.order.validValues"/>
            </propertyGroup>
        </generator>

        <generator
                id="dateConstantGenerator"
                label="%generator.date.constant.label"
                description="%generator.date.constant.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.ConstantGenerator">
            <type kind="DATETIME"/>

            <propertyGroup label="General">
                <property id="value" label="%generator.date.constant.property.value.label" type="string" defaultValue="01-01-2000"  description="%generator.date.constant.property.value.description"/>
            </propertyGroup>
        </generator>

        <generator
                id="dateRandomGenerator"
                label="%generator.date.random.label"
                description="%generator.date.random.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.DateRandomGenerator">
            <type kind="DATETIME"/>

            <propertyGroup label="General">
                <property id="startDate" label="%generator.date.random.property.start.label" type="string" defaultValue="01-01-1980" description="%generator.date.random.property.start.description"/>
                <property id="endDate" label="%generator.date.random.property.end.label" type="string" defaultValue="01-01-2020" description="%generator.date.random.property.end.description"/>
            </propertyGroup>
        </generator>

        <generator
                id="dateSequenceGenerator"
                label="%generator.date.sequence.label"
                description="%generator.date.sequence.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.DateSequenceGenerator">
            <type kind="DATETIME"/>

            <propertyGroup label="General">
                <property id="startDate" label="%generator.date.sequence.property.start.label" type="string" defaultValue="${now as dd-MM-yyyy}" description="%generator.date.sequence.property.start.description"/>
                <property id="step" label="%generator.date.sequence.property.step.label" type="integer" defaultValue="1" description="%generator.date.sequence.property.step.description"/>
                <property id="reverse" label="%generator.date.sequence.property.reverse.label" type="boolean" defaultValue="FALSE" description="%generator.date.sequence.property.reverse.description"/>
            </propertyGroup>
        </generator>

        <generator
                id="fkGenerator"
                label="%generator.fk.label"
                description="%generator.fk.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.FKGenerator">
            <!--
                        <propertyGroup label="General">
                            <property id="numberRefRecords" label="Ref Records" type="integer" defaultValue="1000000" description="Size limit of referenced keys dictionary"/>
                        </propertyGroup>
            -->
        </generator>

        <generator
                id="stringConstantGenerator"
                label="String Constant"
                description="Constant string"
                class="org.jkiss.dbeaver.mockdata.engine.generator.ConstantGenerator">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="value" label="Value" type="string"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringTextGenerator"
                label="%generator.string.text.label"
                description="%generator.string.text.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.StringTextGenerator"
                tags="text,paragraph,chapter">
            <type kind="STRING"/>
            <type kind="CONTENT"/>

            <propertyGroup label="General">
                <property id="template" label="%generator.string.text.property.template.label" type="string" description="%generator.string.text.property.template.description"
                          defaultValue="%generator.string.text.property.template.value"/>
                <property id="minLength" label="%generator.string.text.property.min.label" type="integer" defaultValue="1" description="%generator.string.text.property.min.description"/>
                <property id="maxLength" label="%generator.string.text.property.max.label" type="integer" defaultValue="100" description="%generator.string.text.property.max.description"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringUuidGenerator"
                label="%generator.string.uuid.label"
                description="%generator.string.uuid.label"
                class="org.jkiss.dbeaver.mockdata.engine.generator.StringUuidGenerator"
                tags="id,uuid">
            <type kind="STRING"/>
            <type name="UUID"/>
        </generator>

        <generator
                id="zeroGenerator"
                label="%generator.zero.label"
                description="%generator.zero.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.NullGenerator">
            <type kind="BOOLEAN"/>
            <type kind="DATETIME"/>
            <type kind="NUMERIC"/>
            <type kind="STRING"/>
        </generator>

        <generator
                id="numericAdvancedGenerator"
                label="%generator.numeric.random.label"
                description="%generator.numeric.random.description"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.NumericAdvancedGenerator">
            <type kind="NUMERIC"/>

            <propertyGroup label="General">
                <property id="minimum" label="Minimum" type="double" defaultValue="0"/>
                <property id="maximum" label="Maximum" type="double" defaultValue="1000000"/>
                <property id="precision" label="Precision" type="integer"/>
                <property id="scale" label="Scale" type="integer"/>
            </propertyGroup>

            <preset id="presetNumericPrice" label="Numeric Price" mnemonics="$€¥" description="Price like numerics">
                <property id="minimum" type="double" defaultValue="0"/>
                <property id="precision" type="integer" defaultValue="6"/>
                <property id="scale" type="integer" defaultValue="2"/>
            </preset>

            <preset id="presetNumericLatitude" label="Coordinate" mnemonics="L/L" description="Latitude/Longitude">
                <property id="minimum" type="double" defaultValue="0"/>
                <property id="maximum" type="double" defaultValue="90"/>
                <property id="precision" type="integer" defaultValue="4"/>
                <property id="scale" type="integer" defaultValue="2"/>
            </preset>
        </generator>

        <generator
                id="stringAddressGenerator"
                label="Address"
                description="Random US Address"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringAddressGenerator"
                tags="address,street,avenue">
            <type kind="STRING"/>
        </generator>

        <generator
                id="stringCityGenerator"
                label="City"
                description="World largest cities"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringCityGenerator"
                tags="city,town">
            <type kind="STRING"/>
        </generator>

        <generator
                id="stringCountryGenerator"
                label="Country"
                description="Country"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringCountryGenerator"
                tags="country">
            <type kind="STRING"/>
        </generator>

        <generator
                id="stringDomainGenerator"
                label="Domain"
                description="Top Internet Domains"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringDomainGenerator"
                tags="domain">
            <type kind="STRING"/>
        </generator>

        <generator
                id="stringEmailGenerator"
                label="Email"
                description="E-mail address"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringEmailGenerator"
                tags="email,e-mail">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="gender" label="Gender" type="string" defaultValue="ALL" validValues="ALL,FEMALE,MALE"/>
                <property id="withSurnames" label="With Surname" type="boolean" defaultValue="true"/>
                <property id="numericSuffixSize" label="Numeric Suffix Size" type="integer" defaultValue="2"
                          description="0 value means no suffix"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringNameGenerator"
                label="Name"
                description="Personal name"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringNameGenerator"
                tags="name">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="gender" label="Gender" type="string" defaultValue="ALL" validValues="ALL,FEMALE,MALE"/>
                <property id="withSurnames" label="With Surname" type="boolean" defaultValue="false"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringPriceGenerator"
                label="Price"
                description="Price"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringPriceGenerator"
                tags="price">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="country" label="Country" type="string" defaultValue="UK"
                          validValues="China,France,Germany,Italy,Japan,Russia,UK,USA"/> <!-- $,€,Fr,kr,£,₽,₹,¥ -->
                <property id="min" label="Minimum" type="double" defaultValue="0"/>
                <property id="max" label="Maximum" type="double" defaultValue="1000"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringRegexGeneratorForLob"
                label="%generator.content.label"
                description="%generator.content.description"
                link="Syntax description"
                url="https://code.google.com/archive/p/xeger/wikis/XegerLimitations.wiki"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringRegexGenerator">
            <type kind="CONTENT"/>
            <type kind="BINARY"/>

            <propertyGroup label="General">
                <property id="regex" label="Regex" type="string" defaultValue="[a-fA-F0-9]{1111,9999}"
                          description="Simple regex clause. Examples:\n                                     [0-9]+ ==> one or more digits\n                                [a-zA-Z]* ==> none, one or several letters\n               $[0-9]{1,5}\.[0-9]{2} ==> '$25.99'\n [a-z]{5,15}\@[a-z]{5,}\.com ==> 'somename@somedomain.com'"/>
            </propertyGroup>
        </generator>

        <generator
                id="stringRegexGenerator"
                label="Regex Random"
                description="Simple regex based generator"
                link="Syntax description"
                url="https://code.google.com/archive/p/xeger/wikis/XegerLimitations.wiki"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringRegexGenerator">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="regex" label="Regex" type="string" defaultValue="[a-zA-Z0-9]*"
                          description="Simple regex clause. Examples:\n                                     [0-9]+ ==> one or more digits\n                                [a-zA-Z]* ==> none, one or several letters\n               $[0-9]{1,5}\.[0-9]{2} ==> '$25.99'\n [a-z]{5,15}\@[a-z]{5,}\.com ==> 'somename@somedomain.com'"/>
            </propertyGroup>

            <preset id="presetRegexCreditCard" label="Credit Card" mnemonics="💳" description="Credit card numbers"
                    tags="credit,card">
                <property id="regex" defaultValue="([0-9]{4}-){3}[0-9]{4}"/>
            </preset>

            <preset id="presetRegexEmail" label="Email" mnemonics="@" description="E-mail addresses">
                <property id="regex" defaultValue="[a-z]{5,15}\@[a-z]{5,}\.com"/>
            </preset>

            <preset id="presetRegexGender" label="Gender" mnemonics="♀♂" description="Male/Female"
                    tags="gender,sex,male">
                <property id="regex" defaultValue="(Male|Female)"/>
            </preset>

            <preset id="presetRegexHexColor" label="HEX Color" mnemonics="#" description="HEX color values"
                    tags="color,hex">
                <property id="regex" defaultValue="\#[a-f0-9]{6}"/>
            </preset>

            <preset id="presetRegexIP4" label="IP4" mnemonics="IP4" description="IP4 addresses" tags="ip4">
                <property id="regex"
                          defaultValue="(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])"/>
            </preset>

            <preset id="presetRegexIP6" label="IP6" mnemonics="IP6" description="IP6 addresses" tags="ip6">
                <property id="regex" defaultValue="([a-f0-9]{4}:){3}[a-f0-9]{4}"/>
            </preset>

            <preset id="presetRegexPhone" label="Phone Number" mnemonics="📞" description="Phone numbers" tags="phone">
                <property id="regex" defaultValue="\+[1-9][0-9]{1,2}\([0-9]{3}\)[0-9]{3}-[0-9]{3}"/>
            </preset>

            <preset id="presetRegexPostalCode" label="Postal Code" mnemonics="📯" description="Postal codes"
                    tags="post">
                <property id="regex" defaultValue="[0-9]{5}-[0-9]{4}|[0-9]{5}|[A-Z][0-9][A-Z] [0-9][A-Z][0-9]"/>
            </preset>

            <preset id="presetRegexPrice" label="String Price" mnemonics="$" description="Price like values">
                <property id="regex" defaultValue="$[0-9]{1,5}\.[0-9]{2}"/>
            </preset>
        </generator>

        <generator
                id="stringTemplateGenerator"
                label="Template"
                description="Template with directives for generators"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.StringTemplateGenerator">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="template" label="Template" type="string"
                          defaultValue="${sequence(1,1)}: ${name(ALL,false)}'s credit card number is ${regex(([0-9]{4}-){3}[0-9]{4})}"
                          description="Template string can contain the directives like '${generator(parameter1,parameter2...)}'. \nThey are processed by the appropriate generators. Here are the available directives \n(with parameters):\naddress() - US postal address,\ncity() - one of the world largest cities,\ncountry() - country,\ndomain() - one of the top Internet domains,\nemail(gender,surname) - e-mail address (gender is ALL|FEMALE|MALE, surname is true|false),\nname(gender,surname) - personal name (gender is ALL|FEMALE|MALE, surname is true|false),\nrandom(minimum,maximum) - random integer,\nregex(pattern) - regex based value for the pattern,\nsequence(start,step) - sequence of integers."/>
            </propertyGroup>
        </generator>

        <generator
                id="stringMarkovChainGenerator"
                label="Random text (Markov)"
                description="Random text based on Hamlet using Markov Chain algorithm"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.markovchain.MarkovChainGenerator">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="minWordCount" label="Min word count" type="integer" defaultValue="5" description="Minimum word count."/>
                <property id="maxWordCount" label="Max word count" type="integer" defaultValue="10" description="Maximum word count."/>
            </propertyGroup>
        </generator>

        <generator
                id="stringFinneganGenerator"
                label="Random text (Finnegan)"
                description="Random text Finnegan algorithm (https://github.com/tommyettinger/Finnegan)"
                class="org.jkiss.dbeaver.mockdata.engine.generator.advanced.finnegan.FinneganTextGenerator">
            <type kind="STRING"/>

            <propertyGroup label="General">
                <property id="schema" label="Words schema" type="string" defaultValue="ENGLISH" description="Words schema."
                          validValues="ENGLISH,FRENCH,LOVECRAFT,GREEK_ROMANIZED,GREEK_AUTHENTIC,RUSSIAN_ROMANIZED,RUSSIAN_AUTHENTIC"/>
                <property id="minWordCount" label="Min word count" type="integer" defaultValue="5" description="Minimum word count."/>
                <property id="maxWordCount" label="Max word count" type="integer" defaultValue="10" description="Maximum word count."/>
            </propertyGroup>
        </generator>

    </extension>

</plugin>
