<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension-point id="org.jkiss.dbeaver.ui.app.config" name="Product configuration" schema="schema/org.jkiss.dbeaver.ui.app.config.exsd"/>

    <extension point="org.jkiss.dbeaver.ui.app.config">
       <page id="welcome" order="1000" class="org.jkiss.dbeaver.ui.app.config.pages.ProductConfigWelcomePage"/>
       <page id="appearance" order="2000" class="org.jkiss.dbeaver.ui.app.config.pages.ProductConfigAppearancePage"/>
       <page id="features" order="3000" class="org.jkiss.dbeaver.ui.app.config.pages.ProductConfigFeaturesPage"/>
       <page id="finalSteps" order="5000" class="org.jkiss.dbeaver.ui.app.config.pages.ProductConfigFinalStepsPage"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command
          id="org.jkiss.dbeaver.ui.app.config.showWizard"
          categoryId="org.jkiss.dbeaver.core.util"
          name="%command.org.jkiss.dbeaver.ui.app.config.showWizard.name"
          description="%command.org.jkiss.dbeaver.ui.app.config.showWizard.description"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.jkiss.dbeaver.ui.app.config.showWizard" class="org.jkiss.dbeaver.ui.app.config.ProductConfigWizardHandler">
         <enabledWhen>
            <test property="org.jkiss.dbeaver.app.config.isAvailable"/>
         </enabledWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution allPopups="false" locationURI="menu:help?after=additions">
         <command commandId="org.jkiss.dbeaver.ui.app.config.showWizard">
            <visibleWhen checkEnabled="true"/>
         </command>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.jkiss.dbeaver.preferences.productConfiguration"
            name="%pref.page.productConfiguration"
            category="org.jkiss.dbeaver.preferences.general"
            class="org.jkiss.dbeaver.ui.app.config.PrefPageProductConfiguration">
         <keywordReference id="org.jkiss.dbeaver.ui.app.config.keyword.features"/>
      </page>
   </extension>

   <extension point="org.eclipse.ui.activities">
      <activity id="org.jkiss.dbeaver.ui.app.config.available" name="%pref.page.productConfiguration">
         <enabledWhen>
            <test property="org.jkiss.dbeaver.app.config.isAvailable" forcePluginActivation="true"/>
         </enabledWhen>
      </activity>
      <activityPatternBinding activityId="org.jkiss.dbeaver.ui.app.config.available"
            isEqualityPattern="true"
            pattern="org.jkiss.dbeaver.ui.app.config/org.jkiss.dbeaver.preferences.productConfiguration"/>
   </extension>

   <extension point="org.eclipse.ui.keywords">
      <keyword id="org.jkiss.dbeaver.ui.app.config.keyword.features" label="%pref.keyword.features"/>
   </extension>

</plugin>
