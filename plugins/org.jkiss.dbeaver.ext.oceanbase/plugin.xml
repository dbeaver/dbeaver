<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource
            class="org.jkiss.dbeaver.ext.oceanbase.OceanbaseDataSourceProvider"
            description="Oceanbase"
            id="oceanbase"
            parent="mysql"
            dialect="mysql"
            label="Oceanbase">
            <treeInjection path="mysql/database"
                           changeFolderType="org.jkiss.dbeaver.ext.oceanbase.model.OceanbaseMySQLCatalog"/>
            <treeInjection path="mysql/database/view/column"
                           changeFolderType="org.jkiss.dbeaver.ext.oceanbase.model.OceanbaseMySQLViewColumn"/>
            <drivers managable="true">
                <driver
                    id="alipay_oceanbase"
                    label="OceanBase"
                    class="com.oceanbase.jdbc.Driver"
                    sampleURL="jdbc:oceanbase://{host}[:{port}][/{database}]"
                    defaultPort="2881"
                    webURL="https://open.oceanbase.com"
                    icon="icons/ob_icon.png"
                    iconBig="icons/ob_icon_big.png"
                    description="Driver for OceanBase (MySQL tenant mode)"
                    supportedPageFields="host,port,database,server"
                    categories="sql">

                    <property name="@dbeaver-default-resultset.maxrows.sql" value="true"/>
                    <file type="jar" path="maven:/com.oceanbase:oceanbase-client:RELEASE[2.4.18]"/>
                    <parameter name="supports-events" value="false"/>
                    <parameter name="supports-plugins" value="false"/>
                    <parameter name="supports-triggers" value="false"/>
                    <parameter name="supports-users" value="true"/>
                </driver>
                <main-properties drivers="*">
                    <propertyGroup label="Connection">
                        <property id="host" label="Host" type="string" required="true"/>
                        <property id="port" label="Port" type="string"/>
                        <property id="database" label="Database" type="string"/>
                        <property id="server" label="Tenant" type="string" required="true"/>
                    </propertyGroup>
                </main-properties>
            </drivers>
        </datasource>
        <datasource
            class="org.jkiss.dbeaver.ext.oceanbase.OceanbaseOracleDataSourceProvider"
            description="Oceanbase (Oracle mode)"
            id="oceanbase_oracle"
            parent="generic"
            dialect="oracle"
            icon="icons/ob_icon.png"
            label="Oceanbase (Oracle)">
            <drivers managable="true">
                <driver
                    id="alipay_oceanbase_oracle"
                    label="OceanBase (Oracle)"
                    class="com.oceanbase.jdbc.Driver"
                    sampleURL="jdbc:oceanbase://{host}[:{port}][/{database}]"
                    defaultPort="2881"
                    webURL="https://open.oceanbase.com"
                    icon="icons/ob_icon.png"
                    iconBig="icons/ob_icon_big.png"
                    description="Driver for OceanBase (Oracle tenant mode)"
                    supportedPageFields="host,port,database,server"
                    categories="sql">

                    <property name="@dbeaver-default-resultset.maxrows.sql" value="true"/>
                    <file type="jar" path="maven:/com.oceanbase:oceanbase-client:RELEASE[2.4.18]"/>
                </driver>
            </drivers>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceAuth">
        <authModel
            id="oceanbase_native"
            label="Oceanbase Native"
            description="Oceanbase native authentication (name/password)"
            class="org.jkiss.dbeaver.ext.oceanbase.model.auth.OceanbaseAuthModelDatabaseNative"
            default="true">
            <replace model="native"/>
            <datasource id="oceanbase"/>
            <datasource id="oceanbase_oracle"/>
        </authModel>
    </extension>

</plugin>
