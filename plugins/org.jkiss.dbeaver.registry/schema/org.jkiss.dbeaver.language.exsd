<!-- Schema file written by PDE -->
<schema targetNamespace="org.jkiss.dbeaver.registry" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appinfo>
         <meta.schema plugin="org.jkiss.dbeaver.registry" id="org.jkiss.dbeaver.language" name="Language description"/>
      </appinfo>
      <documentation>Plugin Service</documentation>
   </annotation>

   <element name="extension">
      <annotation><appinfo><meta.element/></appinfo></annotation>
      <complexType>
         <sequence>
            <element ref="language" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="point" type="string" use="required"/>
      </complexType>
   </element>

   <element name="language">
      <complexType>
         <attribute name="code" type="string" use="required">
