<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="org.jkiss.dbeaver.registry" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appInfo>
         <meta.schema plugin="org.jkiss.dbeaver.registry" id="org.jkiss.dbeaver.task" name="Tasks"/>
      </appInfo>
      <documentation>Tasks</documentation>
   </annotation>

   <element name="extension">
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="category"/>
            <element ref="task"/>
            <element ref="scheduler"/>
         </choice>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string">
            <annotation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="task">
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="datasource"/>
            <element ref="objectType"/>
            <element ref="propertyGroup"/>
         </choice>
         <attribute name="id" type="string" use="required"/>
         <attribute name="type" type="string" use="required"/>
         <attribute name="name" type="string" use="required"/>
         <attribute name="description" type="string"/>
         <attribute name="icon" type="string"/>
         <attribute name="handler" type="string" use="required"><annotation><appInfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.task.DBTTaskHandler"/></appInfo></annotation></attribute>
         <attribute name="supportsVariables" type="boolean"/>
         <attribute name="supportsDistributedMode" type="boolean"/>
         <attribute name="standalone" type="boolean"/>
         <attribute name="requiresMutability" type="boolean"/>
         <attribute name="requiresExportPrivileges" type="boolean"/>
         <attribute name="confirmationMessage" type="string"/>
      </complexType>
   </element>

   <element name="category">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="parent" type="string"/>
         <attribute name="name" type="string" use="required"/>
         <attribute name="description" type="string"/>
         <attribute name="icon" type="string"/>
      </complexType>
   </element>

   <element name="scheduler">
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="propertyGroup"/>
            <element ref="enabledWhen"/>
         </choice>
         <attribute name="name" type="string" use="required"/>
         <attribute name="description" type="string"/>
         <attribute name="class" type="string" use="required"><annotation><appInfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.task.DBTScheduler"/></appInfo></annotation></attribute>
      </complexType>
   </element>

   <element name="datasource">
      <complexType>
         <attribute name="id" type="string"/>
         <attribute name="driver" type="string"/>
         <attribute name="if" type="string"/>
      </complexType>
   </element>

   <element name="objectType">
      <complexType>
         <attribute name="name" type="string" use="required"><annotation><appInfo><meta.attribute kind="java"/></appInfo></annotation></attribute>
         <attribute name="if" type="string"/>
         <attribute name="forceCheck" type="boolean"/>
      </complexType>
   </element>

   <element name="enabledWhen">
      <complexType><sequence><any minOccurs="1" maxOccurs="1" processContents="lax"/></sequence></complexType>
   </element>

   <element name="propertyGroup">
      <complexType>
         <sequence><element ref="property" minOccurs="0" maxOccurs="unbounded"/></sequence>
         <attribute name="label" type="string"/>
      </complexType>
   </element>

   <element name="property">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="label" type="string"/>
         <attribute name="description" type="string"/>
         <attribute name="hint" type="string"/>
         <attribute name="type" type="string"/>
         <attribute name="required" type="boolean"/>
         <attribute name="defaultValue" type="string"/>
         <attribute name="validValues" type="string"/>
         <attribute name="allowCustomValues" type="boolean"/>
         <attribute name="features" type="string"/>
         <attribute name="length" type="string"/>
         <attribute name="desktop" type="boolean"/>
         <attribute name="hidden" type="boolean"/>
         <attribute name="hideExpr" type="string"/>
         <attribute name="readOnlyExpr" type="string"/>
      </complexType>
   </element>






</schema>
