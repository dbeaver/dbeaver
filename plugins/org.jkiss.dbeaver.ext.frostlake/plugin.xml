<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <!--
        Frostlake reuses the GENERIC model for everything JDBC metadata already answers — catalogs,
        schemas, tables, views, columns, primary and foreign keys, procedures and functions. Only the
        Snowflake-shaped objects that have no JDBC metadata call need nodes of their own, and those are
        declared in the <tree> below.
    -->
    <extension point="org.jkiss.dbeaver.generic.meta">
        <meta id="frostlake"
              class="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeMetaModel"
              driverClass="dev.frostlake.jdbc.DatabaseDriver"/>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">

        <datasource
                class="org.jkiss.dbeaver.ext.frostlake.FrostlakeDataSourceProvider"
                description="%datasource.frostlake.description"
                id="frostlake"
                parent="generic"
                label="Frostlake"
                icon="icons/frostlake_icon.svg"
                dialect="frostlake">

            <drivers managable="true">

                <!--
                    Frostlake speaks three URL forms, and each gets its own driver entry so the
                    connection dialog can render the right fields for it:
                      jdbc:frostlake://host:port/db   HTTP server        host + port
                      jdbc:frostlake:file:<dir>       in-process, on disk    folder
                      jdbc:frostlake:direct:<name>    in-process, in memory  a name
                -->
                <driver
                        id="frostlake"
                        label="Frostlake"
                        class="dev.frostlake.jdbc.DatabaseDriver"
                        icon="icons/frostlake_icon.svg"
                        iconBig="icons/frostlake_icon_big.svg"
                        sampleURL="jdbc:frostlake://{host}[:{port}]/[{database}]"
                        defaultPort="18082"
                        defaultDatabase="FROSTLAKE"
                        description="Frostlake — a local Snowflake-compatible SQL engine"
                        webURL="https://frostlake.dev"
                        categories="sql,analytic">
                    <file type="jar" path="maven:/dev.frostlake:frostlake-db:RELEASE[0.0.6]"/>

                    <!-- Snowflake semantics the generic model needs told about. -->
                    <parameter name="supports-indexes" value="false"/>
                    <parameter name="supports-references" value="true"/>
                    <parameter name="query-get-active-db" value="SELECT CURRENT_DATABASE()"/>
                    <parameter name="query-set-active-db" value="USE DATABASE &quot;?&quot;"/>
                    <parameter name="active-entity-type" value="catalog"/>
                </driver>

                <driver
                        id="frostlake_embedded"
                        label="Frostlake (embedded file)"
                        class="dev.frostlake.jdbc.DatabaseDriver"
                        icon="icons/frostlake_icon.svg"
                        iconBig="icons/frostlake_icon_big.svg"
                        sampleURL="jdbc:frostlake:file:{folder}"
                        embedded="true"
                        description="Frostlake in-process, persisted to a directory (survives restarts)"
                        categories="sql,analytic,embedded">
                    <file type="jar" path="maven:/dev.frostlake:frostlake-db:RELEASE[0.0.6]"/>
                    <parameter name="supports-indexes" value="false"/>
                    <parameter name="supports-references" value="true"/>
                    <parameter name="query-get-active-db" value="SELECT CURRENT_DATABASE()"/>
                    <parameter name="query-set-active-db" value="USE DATABASE &quot;?&quot;"/>
                    <parameter name="active-entity-type" value="catalog"/>
                </driver>


                <!--
                    In-process and in-memory: connections naming the same <name> share one engine for
                    the JVM's lifetime and different names are isolated, which is H2's mem-DB model.
                    Nothing is written to disk, so closing DBeaver discards the data — this is the entry
                    for scratch work and for pointing at an engine another part of the JVM registered
                    under the same name.
                -->
                <driver
                        id="frostlake_direct"
                        label="Frostlake (in-memory)"
                        class="dev.frostlake.jdbc.DatabaseDriver"
                        icon="icons/frostlake_icon.svg"
                        iconBig="icons/frostlake_icon_big.svg"
                        sampleURL="jdbc:frostlake:direct:{database}"
                        embedded="true"
                        defaultDatabase="frostlake"
                        description="Frostlake in-process, held in memory and discarded on exit"
                        categories="sql,analytic,embedded">
                    <file type="jar" path="maven:/dev.frostlake:frostlake-db:RELEASE[0.0.6]"/>
                    <parameter name="supports-indexes" value="false"/>
                    <parameter name="supports-references" value="true"/>
                    <parameter name="query-get-active-db" value="SELECT CURRENT_DATABASE()"/>
                    <parameter name="query-set-active-db" value="USE DATABASE &quot;?&quot;"/>
                    <parameter name="active-entity-type" value="catalog"/>
                </driver>

            </drivers>

            <!--
                The navigator tree. Everything down to tables/views/procedures comes from the generic
                model; the folders under a schema are the Snowflake object kinds, each backed by the
                matching SHOW command. They share one node type because every Frostlake SHOW listing
                carries the same identifying columns (name, created_on, comment, schema_name) — see
                FrostlakeObjectKind.
            -->
            <tree path="frostlake" label="Frostlake data source" icon="icons/frostlake_icon.svg">

                <!--
                    Account-level objects, siblings of Databases: a warehouse, role or user belongs to
                    no schema, and SHOW … IN SCHEMA is a syntax error for them.
                -->
                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.warehouses.node.name" icon="icons/fl_warehouse.svg">
                    <items label="%tree.warehouse.node.name" path="warehouse" property="warehouses" icon="icons/fl_warehouse.svg"/>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.roles.node.name" icon="icons/fl_role.svg">
                    <items label="%tree.role.node.name" path="role" property="roles" icon="icons/fl_role.svg"/>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.users.node.name" icon="icons/fl_user.svg">
                    <items label="%tree.user.node.name" path="user" property="users" icon="icons/fl_user.svg"/>
                </folder>

                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericCatalog" label="%tree.databases.node.name" icon="icons/fl_database.svg">
                    <items label="%tree.database.node.name" path="catalog" property="catalogs" icon="icons/fl_database.svg">
                        <folder type="org.jkiss.dbeaver.ext.generic.model.GenericSchema" label="%tree.schemas.node.name" icon="icons/fl_schema.svg">
                            <items label="%tree.schema.node.name" path="schema" property="schemas" icon="icons/fl_schema.svg">

                                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericTable" label="%tree.tables.node.name" icon="icons/fl_table.svg">
                                    <items label="%tree.table.node.name" path="table" property="physicalTables" icon="icons/fl_table.svg">
                                        <folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableColumn" label="%tree.columns.node.name" icon="#columns">
                                            <items label="%tree.column.node.name" path="attribute" property="attributes" icon="#column"/>
                                        </folder>
                                        <folder type="org.jkiss.dbeaver.ext.generic.model.GenericUniqueKey" label="%tree.constraints.node.name" icon="#constraints">
                                            <items label="%tree.constraint.node.name" path="uniqueKey" property="constraints" icon="#unique-key">
                                                <items label="%tree.constraint.columns.node.name" itemLabel="%tree.column.node.name" path="column" property="attributeReferences" navigable="false" inline="true"/>
                                            </items>
                                        </folder>
                                        <folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableForeignKey" label="%tree.foreign_keys.node.name" icon="#foreign-keys">
                                            <items label="%tree.foreign_key.node.name" path="association" property="associations" icon="#foreign-key">
                                                <items label="%tree.foreign_key_column.node.name" itemLabel="%tree.column.node.name" path="column" property="attributeReferences" navigable="false" inline="true"/>
                                            </items>
                                        </folder>
                                    </items>
                                </folder>

                                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericView" label="%tree.views.node.name" icon="icons/fl_view.svg">
                                    <items label="%tree.view.node.name" path="view" property="views" icon="icons/fl_view.svg">
                                        <folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableColumn" label="%tree.columns.node.name" icon="#columns">
                                            <items label="%tree.column.node.name" path="attribute" property="attributes" icon="#column"/>
                                        </folder>
                                    </items>
                                </folder>

                                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericProcedure" label="%tree.procedures.node.name" icon="icons/fl_procedure.svg">
                                    <items label="%tree.procedure.node.name" path="procedure" property="proceduresOnly" icon="icons/fl_procedure.svg">
                                        <items label="%tree.procedure_columns.node.name" itemLabel="%tree.column.node.name" path="column" property="parameters" navigable="false" inline="true"/>
                                    </items>
                                </folder>

                                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericProcedure" label="%tree.functions.node.name" icon="icons/fl_function.svg">
                                    <items label="%tree.function.node.name" path="function" property="functionsOnly" icon="icons/fl_function.svg">
                                        <items label="%tree.function_columns.node.name" itemLabel="%tree.column.node.name" path="column" property="parameters" navigable="false" inline="true"/>
                                    </items>
                                </folder>

                                <!-- The Snowflake-shaped objects JDBC cannot reach. One node type, many kinds. -->
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.stages.node.name" icon="icons/fl_stage.svg">
                                    <items label="%tree.stage.node.name" path="stage" property="stages" icon="icons/fl_stage.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.pipes.node.name" icon="icons/fl_pipe.svg">
                                    <items label="%tree.pipe.node.name" path="pipe" property="pipes" icon="icons/fl_pipe.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.streams.node.name" icon="icons/fl_stream.svg">
                                    <items label="%tree.stream.node.name" path="stream" property="streams" icon="icons/fl_stream.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.tasks.node.name" icon="icons/fl_task.svg">
                                    <items label="%tree.task.node.name" path="task" property="tasks" icon="icons/fl_task.svg"/>
                                </folder>
                                <!-- Sequences come from the generic model, which already lists them. -->
                                <folder type="org.jkiss.dbeaver.ext.generic.model.GenericSequence" label="%tree.sequences.node.name" icon="icons/fl_sequence.svg">
                                    <items label="%tree.sequence.node.name" path="sequence" property="sequences" icon="icons/fl_sequence.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.fileFormats.node.name" icon="icons/fl_file_format.svg">
                                    <items label="%tree.fileFormat.node.name" path="fileFormat" property="fileFormats" icon="icons/fl_file_format.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.dynamicTables.node.name" icon="icons/fl_dynamic_table.svg">
                                    <items label="%tree.dynamicTable.node.name" path="dynamicTable" property="dynamicTables" icon="icons/fl_dynamic_table.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.tags.node.name" icon="icons/fl_tag.svg">
                                    <items label="%tree.tag.node.name" path="tag" property="tags" icon="icons/fl_tag.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.maskingPolicies.node.name" icon="icons/fl_masking_policy.svg">
                                    <items label="%tree.maskingPolicy.node.name" path="maskingPolicy" property="maskingPolicies" icon="icons/fl_masking_policy.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.rowAccessPolicies.node.name" icon="icons/fl_row_access_policy.svg">
                                    <items label="%tree.rowAccessPolicy.node.name" path="rowAccessPolicy" property="rowAccessPolicies" icon="icons/fl_row_access_policy.svg"/>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeObject" label="%tree.cortexSearchServices.node.name" icon="icons/fl_cortex_search.svg">
                                    <items label="%tree.cortexSearchService.node.name" path="cortexSearchService" property="cortexSearchServices" icon="icons/fl_cortex_search.svg"/>
                                </folder>

                            </items>
                        </folder>
                    </items>
                </folder>
            </tree>

        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect id="frostlake"
                 parent="generic"
                 class="org.jkiss.dbeaver.ext.frostlake.model.FrostlakeSQLDialect"
                 label="Frostlake"
                 description="Frostlake SQL dialect (Snowflake-compatible)."
                 icon="icons/frostlake_icon.svg"/>
    </extension>

</plugin>
