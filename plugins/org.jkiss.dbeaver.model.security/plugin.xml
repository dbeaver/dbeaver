<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension id="MacOSKeychain" point="org.eclipse.equinox.security.secureStorage">
        <provider class="org.jkiss.dbeaver.model.security.macos.MacOSPasswordProvider"
                  description="Stores the encryption password in the macOS Keychain"
                  priority="1">
            <hint value="AutomaticPasswordGeneration"/>
        </provider>
    </extension>
</plugin>
