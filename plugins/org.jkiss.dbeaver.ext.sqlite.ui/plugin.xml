<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.jkiss.dbeaver.service">
        <service name="org.jkiss.dbeaver.ext.sqlite.SQLiteExtensionConfirmation"
                 class="org.jkiss.dbeaver.ext.sqlite.ui.SQLiteExtensionConfirmationImpl"/>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceConfigurator">
        <configurator dataSource="sqlite" class="org.jkiss.dbeaver.ext.sqlite.ui.SQLiteConnectionPage"/>
    </extension>

    <extension point="org.eclipse.core.runtime.adapters">
        <factory adaptableType="org.jkiss.dbeaver.ext.sqlite.SQLiteExtensionLoadingException"
                 class="org.jkiss.dbeaver.ext.sqlite.ui.SQLiteExtensionsErrorAction">
            <adapter type="org.jkiss.dbeaver.ui.IErrorAction"/>
        </factory>
    </extension>

    <extension point="org.jkiss.dbeaver.resultset.error">
        <action class="org.jkiss.dbeaver.ext.sqlite.ui.SQLiteExtensionsErrorAction"
                label="%extension_settings_error_action"
                description="%extension_settings_error_description"
                icon="platform:/plugin/org.jkiss.dbeaver.ext.sqlite/icons/sqlite_icon.png"
                order="10"/>
    </extension>

    <extension point="org.jkiss.dbeaver.dataManager">
        <manager class="org.jkiss.dbeaver.ext.sqlite.ui.data.manager.SQLiteValueManager" id="org.jkiss.dbeaver.ext.sqlite.ui.data.manager.SQLiteValueManager">
            <supports dataSource="org.jkiss.dbeaver.ext.sqlite.model.SQLiteDataSource"/>
        </manager>
    </extension>

    <extension point="org.jkiss.dbeaver.fileTypeHandler">
        <handler id="sqlite" class="org.jkiss.dbeaver.ext.sqlite.ui.SQLiteFileDatabaseHandler" remote="false" order="101">
            <extension id="sqlite" extensions="db,sdb,sqlite,db3,s3db,sqlite3,sl3,db2,s2db,sqlite2,sl2" icon="platform:/plugin/org.jkiss.dbeaver.ext.sqlite/icons/sqlite_icon_big.png"/>
        </handler>
    </extension>

    <extension point="org.jkiss.dbeaver.ui.propertyConfigurator">
        <propertyConfigurator class="org.jkiss.dbeaver.ext.sqlite.auth.LibSQLAuthModelToken"
                              uiClass="org.jkiss.dbeaver.ext.sqlite.ui.config.LibSQLTokenAuthModelConfigurator"/>
    </extension>

</plugin>
