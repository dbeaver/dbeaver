<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.jkiss.dbeaver.dataManager">
        <manager class="org.jkiss.dbeaver.ext.sqlite.ui.data.manager.SQLiteValueManager" id="org.jkiss.dbeaver.ext.sqlite.ui.data.manager.SQLiteValueManager">
            <supports dataSource="org.jkiss.dbeaver.ext.sqlite.model.SQLiteDataSource"/>
        </manager>
    </extension>

    <extension point="org.jkiss.dbeaver.ui.propertyConfigurator">
        <propertyConfigurator class="org.jkiss.dbeaver.ext.sqlite.auth.LibSQLAuthModelDatabase"
                              uiClass="org.jkiss.dbeaver.ext.sqlite.ui.config.LibSQLTokenAuthModelConfigurator"/>
    </extension>


    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.sqlite.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                dataSource="sqlite"
                class="org.jkiss.dbeaver.ext.sqlite.ui.views.LibSQLConnectionPage"
                label="%sqlite.dialog.connection.header"
                icon="platform:/plugin/org.jkiss.dbeaver.ext.sqlite/icons/sqlite_icon.png">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.sqlite.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                dataSource="sqlite"
                class="org.jkiss.dbeaver.ext.sqlite.ui.views.LibSQLConnectionPage"
                label="%sqlite.dialog.connection.header"
                icon="platform:/plugin/org.jkiss.dbeaver.ext.sqlite/icons/sqlite_icon.png">
        </view>
    </extension>

</plugin>
