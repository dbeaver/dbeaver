<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource
                class="org.jkiss.dbeaver.ext.starrocks.StarRocksDataSourceProvider"
                description="StarRocks Database"
                id="starrocks"
                parent="mysql"
                dialect="starrocks"
                label="StarRocks"
                icon="icons/starrocks_icon.png">

            <!-- Define StarRocks tree with catalog layer -->
            <tree path="starrocks" label="StarRocks" icon="#folder_database">
                <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksCatalog" label="Catalogs" icon="#folder_schema" description="StarRocks catalogs">
                    <items label="Catalog" path="catalog" property="catalogs" icon="#database">
                        <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksDatabase" label="Databases" icon="#folder_database" description="Databases in catalog">
                            <items label="Database" path="database" property="databases" icon="#database">
                                <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksTable" label="Tables" icon="#folder_table" description="Tables in database">
                                    <items label="Table" path="table" property="tables" icon="#table">
                                        <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksTableColumn" label="Columns" icon="#columns" description="Table columns">
                                            <items label="Column" path="attribute" property="attributes" icon="#column"/>
                                        </folder>
                                    </items>
                                </folder>
                                <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksView" label="Views" icon="#folder_view" description="Views in database">
                                    <items label="View" path="view" property="views" icon="#view">
                                        <folder type="org.jkiss.dbeaver.ext.starrocks.model.StarRocksTableColumn" label="Columns" icon="#columns" description="View columns">
                                            <items label="Column" path="attribute" property="attributes" icon="#column"/>
                                        </folder>
                                    </items>
                                </folder>
                            </items>
                        </folder>
                    </items>
                </folder>
            </tree>

            <drivers managable="true">
                <driver
                        id="starrocks"
                        label="StarRocks"
                        icon="icons/starrocks_icon.png"
                        iconBig="icons/starrocks_icon_big.png"
                        logoImage="icons/starrocks_logo.png"
                        class="com.mysql.cj.jdbc.Driver"
                        sampleURL="jdbc:mysql://{host}[:{port}]/[{database}]"
                        defaultPort="9030"
                        defaultUser="root"
                        webURL="https://docs.starrocks.io/"
                        description="StarRocks using MySQL 8 driver"
                        categories="sql">
                    <file type="jar" path="maven:/com.mysql:mysql-connector-j:RELEASE[8.3.0]" bundle="!drivers.mysql"/>
                    <file type="license" path="https://www.gnu.org/licenses/old-licenses/lgpl-2.0.txt" bundle="!drivers.mysql"/>
                    <file type="license" path="drivers/mysql/LICENSE.txt" bundle="drivers.mysql"/>
                    <file type="jar" path="drivers/mysql/mysql8" bundle="drivers.mysql"/>
                    <property name="connectTimeout" value="20000"/>
                    <parameter name="supports-partitions" value="false"/>
                    <parameter name="supports-references" value="false"/>
                    <parameter name="supports-triggers" value="false"/>
                    <parameter name="supports-events" value="false"/>
                    <parameter name="supports-users" value="false"/>
                    <parameter name="supports-charsets" value="false"/>
                    <parameter name="supports-collations" value="false"/>
                    <parameter name="supportsClients" value="false"/>
                </driver>
            </drivers>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect id="starrocks" parent="mysql" class="org.jkiss.dbeaver.ext.starrocks.StarRocksDialect"
                 label="StarRocks" description="StarRocks SQL dialect" icon="icons/starrocks_icon.png">
            <keywords value=""/>
            <functions value=""/>
            <types value=""/>
        </dialect>
    </extension>
</plugin>
