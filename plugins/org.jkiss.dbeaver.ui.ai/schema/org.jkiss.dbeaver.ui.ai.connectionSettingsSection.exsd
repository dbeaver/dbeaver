<?xml version='1.0' encoding='UTF-8'?>
<schema targetNamespace="org.jkiss.dbeaver.ui.ai" xmlns="http://www.w3.org/2001/XMLSchema">
   <annotation>
      <appInfo>
         <meta.schema plugin="org.jkiss.dbeaver.ui.ai" id="connectionSettingsSection" name="AI connection settings section"/>
      </appInfo>
      <documentation>Contributes a section to the AI connection settings page.</documentation>
   </annotation>
   <element name="extension">
      <annotation><appInfo><meta.element/></appInfo></annotation>
      <complexType>
         <sequence>
            <element ref="section" minOccurs="0" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string"/>
      </complexType>
   </element>
   <element name="section">
      <complexType>
         <attribute name="class" type="string" use="required">
            <annotation><appInfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.ui.ai.preferences.AIConnectionSettingsSection"/></appInfo></annotation>
         </attribute>
      </complexType>
   </element>
</schema>
