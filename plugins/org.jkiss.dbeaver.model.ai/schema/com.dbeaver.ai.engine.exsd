            <annotation><appinfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.ai.engine.AIEngineProperties"/></appinfo></annotation>
         </attribute>
         <attribute name="promoted" type="boolean">
             <annotation>
                <documentation>Whether the engine should be shown before regular engines in selection controls.</documentation>
             </annotation>
         </attribute>
         <attribute name="supportsFunctions" type="boolean"/>
         <attribute name="providesMetadata" type="boolean"/>
         <attribute name="default" type="boolean"/>
         <attribute name="replaces" type="string"/>
         <attribute name="fallbacks" type="string"/>
      </complexType>
   </element>


</schema>
