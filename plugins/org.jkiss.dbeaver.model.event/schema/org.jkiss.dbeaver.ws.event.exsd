<?xml version='1.0' encoding='UTF-8'?>
<schema targetNamespace="org.jkiss.dbeaver.model.event" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appinfo>
         <meta.schema plugin="org.jkiss.dbeaver.model.event" id="org.jkiss.dbeaver.ws.event" name="WebSocket event"/>
      </appinfo>
      <documentation>WebSocket events</documentation>
   </annotation>

   <element name="extension">
      <annotation><appinfo><meta.element/></appinfo></annotation>
      <complexType>
         <choice minOccurs="0" maxOccurs="unbounded">
            <element ref="event"/>
            <element ref="clientEvent"/>
         </choice>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string"/>
      </complexType>
   </element>

   <element name="event">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="topicId" type="string" use="required"/>
         <attribute name="class" type="string" use="required">
            <annotation><appinfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.websocket.event.WSEvent"/></appinfo></annotation>
         </attribute>
      </complexType>
   </element>

   <element name="clientEvent">
      <complexType>
         <attribute name="id" type="string" use="required"/>
         <attribute name="class" type="string" use="required">
            <annotation><appinfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.websocket.event.WSClientEvent"/></appinfo></annotation>
         </attribute>
         <attribute name="handler" type="string">
            <annotation><appinfo><meta.attribute kind="java" basedOn=":org.jkiss.dbeaver.model.websocket.event.WSClientEventHandler"/></appinfo></annotation>
         </attribute>
      </complexType>
   </element>
</schema>
