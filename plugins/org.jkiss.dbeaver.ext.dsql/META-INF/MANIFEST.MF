Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: DBeaver AWS Aurora DSQL Model
Bundle-SymbolicName: org.jkiss.dbeaver.ext.dsql;singleton:=true
Bundle-Version: 1.0.151.qualifier
Bundle-Release-Date: 20250721
Require-Bundle: org.jkiss.dbeaver.model,
 org.jkiss.dbeaver.ext.generic,
 org.jkiss.dbeaver.ext.postgresql,
 org.jkiss.dbeaver.ext.postgresql.ui
Import-Package: org.jkiss.code,
 org.jkiss.dbeaver.model.sql.format
Bundle-ClassPath: .,
    target/lib/annotations.jar,
    target/lib/apache-client.jar,
    target/lib/auth.jar,
    target/lib/aws-core.jar,
    target/lib/aws-json-protocol.jar,
    target/lib/checksums.jar,
    target/lib/checksums-spi.jar,
    target/lib/dsql.jar,
    target/lib/endpoints-spi.jar,
    target/lib/http-auth.jar,
    target/lib/http-auth-aws.jar,
    target/lib/http-auth-aws-eventstream.jar,
    target/lib/http-auth-spi.jar,
    target/lib/http-client-spi.jar,
    target/lib/identity-spi.jar,
    target/lib/json-utils.jar,
    target/lib/metrics-spi.jar,
    target/lib/netty-nio-client.jar,
    target/lib/profiles.jar,
    target/lib/protocol-core.jar,
    target/lib/regions.jar,
    target/lib/retries.jar,
    target/lib/retries-spi.jar,
    target/lib/sdk-core.jar,
    target/lib/third-party-jackson-core.jar,
    target/lib/utils.jar
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-Vendor: DBeaver Corp
Automatic-Module-Name: org.jkiss.dbeaver.ext.dsql
Export-Package: org.jkiss.dbeaver.ext.dsql,
 org.jkiss.dbeaver.ext.dsql.constants
