<plugin>

    <extension point="org.eclipse.ui.commands">
        <category id="org.jkiss.dbeaver.ext.dm" name="Dm" description="Dm Commands"/>
        <command id="org.jkiss.dbeaver.ext.dm.code.compile" name="Compile" description="Compile" categoryId="org.jkiss.dbeaver.ext.dm"/>
        <command id="org.jkiss.dbeaver.ext.dm.code.package.navigate" name="Go to source code" description="Navigate to object source code" categoryId="org.jkiss.dbeaver.ext.dm"/>
        <command id="org.jkiss.dbeaver.ext.dm.job.run" name="Run" description="Run Job" categoryId="org.jkiss.dbeaver.ext.dm"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.dm.code.compile" icon="icons/compile.png"/>
        <image commandId="org.jkiss.dbeaver.ext.dm.code.package.navigate" icon="icons/source_navigate.png"/>
        <image commandId="org.jkiss.dbeaver.ext.dm.job.run" icon="icons/run.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.dm.code.compile" class="org.jkiss.dbeaver.ext.dm.ui.actions.CompileHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                <instanceof value="org.jkiss.dbeaver.ext.dm.model.source.DmSourceObject"/>
                            </adapt>
                        </iterate>
                    </with>
                    <with variable="activePart">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.dm.model.source.DmSourceObject"/>
                        </adapt>
                    </with>
                </or>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.dm.code.compile">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.dm.code.package.navigate">
                <visibleWhen checkEnabled="true"/>
            </command>
            <command commandId="org.jkiss.dbeaver.ext.dm.job.run">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.editors">
        <editor
                name="Session Manager"
                icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/sessions.png"
                class="org.jkiss.dbeaver.ext.dm.ui.editors.DmSessionEditor"
                id="org.jkiss.dbeaver.ext.dm.ui.editors.DmSessionEditor"
                contributorClass="org.jkiss.dbeaver.ui.editors.EditorSearchActionsContributor">
        </editor>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <editorContribution editorId="org.jkiss.dbeaver.ext.dm.ui.editors.DmSessionEditor" category="connectionEditor" label="%editor.session_manager.name" icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/sessions.png">
            <supports dataSource="dm"/>
        </editorContribution>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page category="org.jkiss.dbeaver.preferences.drivers" id="org.jkiss.dbeaver.preferences.dm.general" class="org.jkiss.dbeaver.ext.dm.ui.views.PrefPageDm" name="Dm">
            <keywordReference id="org.jkiss.dbeaver.core.keyword.dbeaver"/>
        </page>
    </extension>

    <extension point="org.eclipse.ui.propertyPages">
        <page id="org.jkiss.dbeaver.preferences.dm.main" class="org.jkiss.dbeaver.ext.dm.ui.views.PrefPageDm" name="%page.org.jkiss.dbeaver.preferences.dm.main.name">
            <enabledWhen>
                <adapt type="org.jkiss.dbeaver.model.DBPDataSourceContainer">
                    <test property="org.jkiss.dbeaver.core.datasourceContainer.driverId" value="dm_thin"/>
                </adapt>
            </enabledWhen>
        </page>
    </extension>

    <extension point="org.eclipse.ui.importWizards">
        <wizard
                category="org.jkiss.dbeaver.import_config.third-party"
                class="org.jkiss.dbeaver.ext.dm.ui.tools.sqldeveloper.ConfigImportWizardSqlDeveloper"
                id="org.jkiss.dbeaver.import_config.sqldeveloper"
                name="Dm SQL Developer"
                icon="icons/sqldeveloper.png">
            <description>Dm SQL Developer</description>
        </wizard>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.dm.dataSourceWizardView"
                dataSource="dm"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                label="%dialog.connection.header"
                class="org.jkiss.dbeaver.ext.dm.ui.views.DmConnectionPage"
                icon="icons/dm_icon.png">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.dm.dataSourceEditorView"
                dataSource="dm"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                label="%dialog.connection.header"
                class="org.jkiss.dbeaver.ext.dm.ui.views.DmConnectionPage">
        </view>
    </extension>

    <extension point="org.jkiss.dbeaver.databaseEditor">
        <editor id="source.declaration" class="org.jkiss.dbeaver.ext.dm.ui.editors.DmSourceDeclarationEditor"
                label="%editor.package.declaration.name" description="%editor.package.declaration.description" icon="#sql_text" position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmView"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmMaterializedView"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmProcedureStandalone"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmPackage"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmDataType" if="!object.predefined"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTrigger"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTableIndex"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmSequence"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.dm.ui.editors.DmSourceDefinitionEditor"
                label="%editor.package.body.name" description="%editor.package.body.description" icon="#sql_text" position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmPackage"/>
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmDataType" if="!object.predefined"/>
        </editor>
        <editor id="source.ddl" class="org.jkiss.dbeaver.ext.dm.ui.editors.DmObjectDDLEditor"
                label="DDL" description="DDL" icon="#sql_text" position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTable"/>
        </editor>

        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmConstraintConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTableConstraint"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmDataTypeConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmDataType"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmForeignKeyConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTableForeignKey"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmIndexConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTableIndex"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmPackageConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmPackage"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmProcedureConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmProcedureStandalone"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmQueueConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmQueue"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmSchemaConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmSchema"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmSequenceConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmSequence"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.dm.ui.config.DmTableTriggerConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTableTrigger"/>
        </configurator>
    </extension>

    <extension point="org.jkiss.dbeaver.tools">
        <tools>
            <tool
                class="org.jkiss.dbeaver.ext.dm.tools.DmToolExport"
                description="Export database"
                id="org.jkiss.dbeaver.ext.dm.tools.DmToolExport"
                label="备份"
                icon="#export"
                singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.dm.model.DmSchema"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.dm.tools.DmToolImport"
                description="Import database"
                id="org.jkiss.dbeaver.ext.dm.tools.DmToolImport"
                label="还原"
                icon="#import"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.dm.model.DmSchema"/>
            </tool>
            <toolGroup id="org.jkiss.dbeaver.ext.dm.ui.tools.statistics" label="Statistics"/>
            <toolGroup id="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance" label="Maintenance"/>
            <tool
                    class="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance.DmToolRefreshMView"
                    description="Refresh materialized view"
                    id="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance.DmToolRefreshMView"
                    group="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance"
                    label="Refresh materialized view"
                    singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.dm.model.DmMaterializedView"/>
            </tool>
            <tool
                    class="org.jkiss.dbeaver.ext.dm.tools.maintenance.DmToolTruncate"
                    description="清空表数据"
                    id="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance.DmToolTruncate"
                    group="org.jkiss.dbeaver.ext.dm.ui.tools.maintenance"
                    label="Truncate"
                    icon="platform:/plugin/org.jkiss.dbeaver.ui/icons/truncate.png"
                    singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.dm.model.DmTable"/>
            </tool>
        </tools>
    </extension>

    <extension point="org.jkiss.dbeaver.task">
        <configurator type="dmImport" class="org.jkiss.dbeaver.ext.dm.tools.DmTaskConfigurator"/>
        <configurator type="dmExport" class="org.jkiss.dbeaver.ext.dm.tools.DmTaskConfigurator"/>
    </extension>

</plugin>
