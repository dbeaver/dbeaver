<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension point="org.jkiss.dbeaver.service">
        <service
            name="com.dbeaver.db.cdata.CDataLicenseUIService"
            class="com.dbeaver.db.cdata.ui.CDataLicenseUIServiceImpl"/>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
            id="com.dbeaver.db.cdata.ui.newConnectionView"
            targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
            dataSource="cdata"
            label="%cdata.dialog.connection.header"
            class="com.dbeaver.db.cdata.ui.CDataConnectionPage"
            icon="platform:/plugin/com.dbeaver.db.cdata/icons/cdata.svg"/>
        <view
            id="com.dbeaver.db.cdata.ui.editConnectionView"
            targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
            dataSource="cdata"
            label="%cdata.dialog.connection.header"
            class="com.dbeaver.db.cdata.ui.CDataConnectionPage"
            icon="platform:/plugin/com.dbeaver.db.cdata/icons/cdata.svg"/>
    </extension>
</plugin>
