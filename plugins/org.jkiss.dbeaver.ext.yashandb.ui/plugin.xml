<!--        </editor>-->

        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBConstraintConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTableConstraint"/>
        </configurator>

        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBPartitionConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTablePartition"/>
        </configurator>


        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBSchemaConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSchema"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBSequenceConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSequence"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBTableTriggerConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTableTrigger"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBUserProfileConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBUserProfile"/>
        </configurator>
        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBDBLinkConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBDBLink"/>
        </configurator>

        <configurator class="org.jkiss.dbeaver.ext.yashandb.ui.config.YashanDBSchedulerJobConfigurator">
