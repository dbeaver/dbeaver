    <extension point="org.jkiss.dbeaver.tools">
        <tools>
            <toolGroup id="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance" label="Maintenance"/>
            <tool
                    class="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolTruncate"
                    description="Truncate table"
                    id="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolTruncate"
                    group="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance"
                    label="Truncate"
                    singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTable"/>
            </tool>
            <tool
                    class="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolViewUpdate"
                    description="Update View"
                    id="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolViewUpdate"
                    group="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance"
                    label="Update View"
                    singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBView"/>
            </tool>
            <tool
                    class="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolIndexRebuild"
                    description="Rebuild Index"
                    id="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance.YashanDBToolIndexRebuild"
                    group="org.jkiss.dbeaver.ext.yashandb.ui.tools.maintenance"
                    label="Rebuild Index"
                    singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTableIndex"/>
            </tool>
        </tools>
    </extension>

</plugin>
