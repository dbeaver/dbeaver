<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.yashandb.job.run" name="Run" description="Run Job" categoryId="org.jkiss.dbeaver.ext.yashandb"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.yashandb.job.run" icon="icons/run.png"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.yashandb.job.run" class="org.jkiss.dbeaver.ext.yashandb.ui.actions.JobRunHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                <instanceof value="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSchedulerJob"/>
                            </adapt>
                        </iterate>
                    </with>
                    <with variable="activePart">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSchedulerJob"/>
                        </adapt>
                    </with>
                </or>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.yashandb.job.run">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.ui.editors">
        <editor
                name="Session Manager"
                icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/sessions.png"
                class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBSessionEditor"
                id="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBSessionEditor"
                contributorClass="org.jkiss.dbeaver.ui.editors.EditorSearchActionsContributor">
        </editor>
        <editor
                name="Lock Manager"
                icon="#locked"
                class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBLockEditor"
                id="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBLockEditor">
        </editor>

    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <editorContribution editorId="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBSessionEditor" category="connectionEditor" label="Sessions" icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/sessions.png">
            <supports dataSource="yashandb"/>
        </editorContribution>
        <editorContribution editorId="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBLockEditor" category="connectionEditor" label="%editor.lock_manager.name" icon="#locked">-->
            <supports dataSource="yashandb"/>
        </editorContribution>

    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.yashandb.ui.dataSourceWizardView"
                dataSource="yashandb"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                label="%dialog.connection.header"
                class="org.jkiss.dbeaver.ext.generic.views.GenericConnectionPage"
                icon="#database_icon_default">
        </view>
        <view
                class="org.jkiss.dbeaver.ext.generic.views.GenericConnectionPage"
                icon="#database_icon_default"
                id="org.jkiss.dbeaver.ext.yashandb.ui.dataSourceEditorView"
                dataSource="yashandb"
                label="%dialog.connection.header"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog">
        </view>
    </extension>


    <extension point="org.jkiss.dbeaver.databaseEditor">

        <editor id="source.declaration"
                class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBSourceDeclarationEditor"
                label="Declaration" description="%editor.package.declaration.description" icon="#sql_text"
                position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder"
                embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBView"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBMaterializedView"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBProcedureStandalone"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBPackage"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBDataType" if="!object.predefined"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTrigger"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBJob"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSchedulerJob"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBSourceDefinitionEditor"
                label="Body" description="%editor.package.body.description" icon="#sql_text"
                position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder"
                embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBPackage"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBDataType" if="!object.predefined"/>
        </editor>

        <editor id="source.declaration.read-only"
                class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBObjectDeclarationViewer"
                label="Declaration" description="%editor.package.declaration.description" icon="#sql_text"
                position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder"
                embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSequence"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSynonym"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBUserProfile"/>
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBDBLink"/>
        </editor>

        <editor id="source.ddl" class="org.jkiss.dbeaver.ext.yashandb.ui.editors.YashanDBObjectDDLEditor"
                label="DDL" description="DDL" icon="#sql_text" position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBTable"/>
        </editor>

        <editor id="schedulerJob.action" class="org.jkiss.dbeaver.ext.yashandb.ui.editors.SchedulerJobActionEditor"
                label="%editor.scheduler.job.action.name" description="%editor.schedulerJob.action.description" icon="#sql_text" position="additions_middle"
                contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.yashandb.model.YashanDBSchedulerJob"/>
        </editor>

