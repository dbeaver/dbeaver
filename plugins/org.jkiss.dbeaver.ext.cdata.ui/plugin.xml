<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
    <extension point="org.jkiss.dbeaver.service">
        <service
            name="org.jkiss.dbeaver.ext.cdata.CDataLicenseUIService"
            class="org.jkiss.dbeaver.ext.cdata.ui.CDataLicenseUIServiceImpl"/>
    </extension>

    <extension point="org.jkiss.dbeaver.ui.propertyConfigurator">
        <propertyConfigurator
            class="org.jkiss.dbeaver.ext.cdata.CDataAuthModel"
            uiClass="org.jkiss.dbeaver.ui.dialogs.connection.DatabaseNativeAuthModelConfigurator"/>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceConfigurator">
        <configurator
            dataSource="cdata"
            class="org.jkiss.dbeaver.ext.cdata.ui.CDataConnectionPage"/>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page
            category="org.jkiss.dbeaver.preferences.drivers"
            id="org.jkiss.dbeaver.ext.cdata.preferences"
            class="org.jkiss.dbeaver.ext.cdata.ui.CDataPreferencePage"
            name="%cdata.preference.page.name">
            <keywordReference id="org.jkiss.dbeaver.core.keyword.dbeaver"/>
            <keywordReference id="org.jkiss.dbeaver.core.keyword.connection"/>
            <keywordReference id="org.jkiss.dbeaver.ext.cdata.ui.keyword.pref.licenses"/>
        </page>
    </extension>
    <extension point="org.eclipse.ui.keywords">
        <keyword id="org.jkiss.dbeaver.ext.cdata.ui.keyword.pref.licenses" label="%keyword.org.jkiss.dbeaver.ext.cdata.ui.keyword.pref.licenses.label"/>
    </extension>
    <extension point="org.eclipse.ui.activities">
        <activity id="dbeaver.activity.cdata" name="%cdata.activity.name">
            <enabledWhen>
                <test property="org.jkiss.dbeaver.app.config.isFeatureEnabled" value="cdata"/>
            </enabledWhen>
        </activity>
        <activityPatternBinding activityId="dbeaver.activity.cdata" pattern="org\.jkiss\.dbeaver\.ext\.cdata.*"/>
    </extension>
</plugin>
