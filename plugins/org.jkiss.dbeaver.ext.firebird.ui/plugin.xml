<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>

<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view
                id="org.jkiss.dbeaver.ext.firebird.dataSourceWizardView"
                targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
                dataSource="jaybird"
                label="Firebird"
                class="org.jkiss.dbeaver.ext.firebird.ui.FireBirdConnectionPage"
                icon="platform:/plugin/org.jkiss.dbeaver.ext.firebird/icons/firebird_icon.png">
        </view>
        <view
                id="org.jkiss.dbeaver.ext.firebird.dataSourceEditorView"
                targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
                dataSource="jaybird"
                label="Firebird"
                class="org.jkiss.dbeaver.ext.firebird.ui.FireBirdConnectionPage"
                icon="platform:/plugin/org.jkiss.dbeaver.ext.firebird/icons/firebird_icon.png">
        </view>
    </extension>

    <extension point="org.jkiss.dbeaver.tools">
        <tools>
            <toolGroup id="org.jkiss.dbeaver.ext.firebird.tools" label="Firebird Tools"/>
            <tool
                    description="%tool.org.jkiss.dbeaver.ext.firebird.events.description"
                    id="org.jkiss.dbeaver.ext.firebird.ui.tools.FireBirdToolEvents"
                    label="%tool.org.jkiss.dbeaver.ext.firebird.events.name"
                    icon="platform:/plugin/org.jkiss.dbeaver.ext.firebird/icons/firebird_icon.png"
                    group="org.jkiss.dbeaver.ext.firebird.tools"
                    singleton="true">
                <command id="org.jkiss.dbeaver.ext.firebird.ui.events">
                    <objectType name="org.jkiss.dbeaver.ext.firebird.model.FireBirdDataSource"/>
                </command>
            </tool>
        </tools>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command id="org.jkiss.dbeaver.ext.firebird.ui.events" name="%tool.org.jkiss.dbeaver.ext.firebird.events.name"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.firebird.ui.events" class="org.jkiss.dbeaver.ext.firebird.ui.tools.FireBirdEventToolCommandHandler"/>
    </extension>

</plugin>
